{
  "name": "snapsort",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration production",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check": "npm run typecheck && npm test -- --watch=false && npm run build:production",
    "cap:sync": "cap sync android",
    "android:open": "cap open android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:web": "ng build --configuration production,web"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ionic/angular": "^9.0.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "fflate": "^0.8.2",
    "ionicons": "^8.0.13",
